						"source": [
							"# Parameters \n",
							"sql_pool_name = \"ruicunha-contoso-flavor3-ondemand\"  # e.g., myworkspace\n",
							"database_name = \"master\"           # e.g., mydb \n",
							"\n",
							"# Build the JDBC URL for managed identity\n",
							"jdbc_url = f\"jdbc:sqlserver://{sql_pool_name}.sql.azuresynapse.net:1433;\" \\\n",
							"           f\"database={database_name};\" \\\n",
							"           \"encrypt=true;\" \\\n",
							"           \"trustServerCertificate=false;\" \\\n",
							"           \"hostNameInCertificate=*.sql.azuresynapse.net;\" \\\n",
							"           \"authentication=ActiveDirectoryMsi\"\n",
							"\n",
							"# Define the query\n",
							"query = \"SELECT * from sys.tables\"\n",
							"\n",
							"# Read the data using Spark\n",
							"df = spark.read \\\n",
							"    .format(\"jdbc\") \\\n",
							"    .option(\"url\", jdbc_url) \\\n",
							"    .option(\"query\", query) \\\n",
							"    .option(\"driver\", \"com.microsoft.sqlserver.jdbc.SQLServerDriver\") \\\n",
							"    .load()\n",
							"\n",
							"# Show the result\n",
							"df.show(truncate=False)\n",
							""
						],
						"outputs": [],
						"execution_count": 2
					}
				]
			},
			"dependsOn": []
